{
  "openapi": "3.0.3",
  "info": {
    "title": "eSports API - Perfiles de Jugadores y Rosters",
    "description": "API REST para gestionar jugadores y armar rosters de equipos de eSports. Desarrollada con Node.js, Express y Sequelize sobre MySQL.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "API Base v1"
    },
    {
      "url": "http://localhost:3000",
      "description": "Servidor Raíz"
    }
  ],
  "tags": [
    { "name": "General", "description": "Endpoints raíz y de descubrimiento de recursos" },
    { "name": "Autenticación", "description": "Inicio de sesión, cierre y verificación de tokens JWT y CSRF" },
    { "name": "Jugadores", "description": "Operaciones CRUD y búsqueda de jugadores" },
    { "name": "Rosters", "description": "Gestión de equipos y temporadas" },
    { "name": "Asignaciones", "description": "Asignación de jugadores a rosters y control de roles" },
    { "name": "Auxiliares", "description": "Catálogos y estado del servicio" }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["General"],
        "summary": "Bienvenida y enlaces a la documentación",
        "responses": {
          "200": {
            "description": "Información general y enlaces",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": { "type": "string" },
                    "version": { "type": "string" },
                    "documentacion": { "type": "string" },
                    "especificacion_openapi": { "type": "string" },
                    "base_url": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1": {
      "get": {
        "tags": ["General"],
        "summary": "Índice de recursos disponibles en v1",
        "responses": {
          "200": {
            "description": "Mapa de recursos de la API",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": { "type": "string" },
                    "version": { "type": "string" },
                    "recursos": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Iniciar sesión como Administrador (JWT en Cookie + CSRF)",
        "description": "Autentica las credenciales y devuelve una cookie HTTP-Only con el JWT y el token CSRF para peticiones protegidas.",
        "parameters": [
          { "name": "x-api-key", "in": "header", "required": true, "schema": { "type": "string" }, "example": "esports_api_key_secret_2026" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "example": "admin@esports.com" },
                  "password": { "type": "string", "example": "admin123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login exitoso (recibe cookie jwt_token y csrf_token)" },
          "400": { "description": "Email requerido" },
          "401": { "description": "Credenciales inválidas o API Key no válida" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Cerrar sesión y limpiar cookies",
        "responses": {
          "200": { "description": "Sesión finalizada exitosamente" }
        }
      }
    },
    "/auth/verify": {
      "get": {
        "tags": ["Autenticación"],
        "summary": "Verificar estado de autenticación y rol actual",
        "responses": {
          "200": { "description": "Usuario autenticado" },
          "401": { "description": "No autenticado o token expirado" }
        }
      }
    },
    "/jugadores": {
      "get": {
        "tags": ["Jugadores"],
        "summary": "Listar jugadores con filtros",
        "description": "Devuelve la lista de jugadores. Permite filtrar por rol, estado o buscar por nickname.",
        "parameters": [
          { "name": "rol", "in": "query", "schema": { "type": "string", "enum": ["Top", "Jungle", "Mid", "ADC", "Support"] }, "description": "Filtrar por rol del jugador" },
          { "name": "estado", "in": "query", "schema": { "type": "string", "enum": ["activo", "inactivo"] }, "description": "Filtrar por estado" },
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Búsqueda por coincidencia en nickname" }
        ],
        "responses": {
          "200": {
            "description": "Lista de jugadores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Jugador" }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      },
      "post": {
        "tags": ["Jugadores"],
        "summary": "Crear un nuevo jugador",
        "description": "Registra un nuevo jugador. El nickname es obligatorio y único. El rol debe ser válido.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JugadorInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Jugador creado exitosamente",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Jugador" }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o faltantes",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "El campo nickname es obligatorio y no puede estar vacío" }
              }
            }
          },
          "409": {
            "description": "Nickname ya registrado (Conflicto RN-01)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "El nickname \"Faker\" ya está registrado" }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/jugadores/{id}": {
      "get": {
        "tags": ["Jugadores"],
        "summary": "Obtener detalle de un jugador",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Detalle del jugador",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Jugador" }
              }
            }
          },
          "404": {
            "description": "Jugador no encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "Jugador con ID 999 no encontrado" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Jugadores"],
        "summary": "Actualizar un jugador",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JugadorInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Jugador actualizado" },
          "400": {
            "description": "Datos inválidos (ej. nickname vacío o rol inválido)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "El nickname no puede estar vacío" }
              }
            }
          },
          "404": {
            "description": "Jugador no encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "Jugador con ID 999 no encontrado" }
              }
            }
          },
          "409": {
            "description": "Conflicto por nickname duplicado o conflicto de rol titular en rosters existentes (RN-03)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "No se puede cambiar el rol a \"Top\": generaría conflicto en el roster \"TL Principal\" donde ya existe un titular con ese rol (Impact)" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Jugadores"],
        "summary": "Eliminar un jugador",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "204": { "description": "Jugador eliminado exitosamente" },
          "404": {
            "description": "Jugador no encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "Jugador con ID 999 no encontrado" }
              }
            }
          }
        }
      }
    },
    "/rosters": {
      "get": {
        "tags": ["Rosters"],
        "summary": "Listar todos los rosters",
        "parameters": [
          { "name": "tipo", "in": "query", "schema": { "type": "string", "enum": ["Principal", "Academy"] } },
          { "name": "temporada", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Lista de rosters con cantidad de jugadores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/RosterItem" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Rosters"],
        "summary": "Crear un nuevo roster",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RosterInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Roster creado exitosamente" },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "El campo nombre es obligatorio" }
              }
            }
          }
        }
      }
    },
    "/rosters/{id}": {
      "get": {
        "tags": ["Rosters"],
        "summary": "Ver detalle de un roster con sus jugadores",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Datos del roster y jugadores asignados",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RosterDetalle" }
              }
            }
          },
          "404": {
            "description": "Roster no encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "Roster con ID 999 no encontrado" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Rosters"],
        "summary": "Actualizar un roster",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RosterInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Roster actualizado" },
          "400": {
            "description": "Datos inválidos (ej. nombre vacío)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "El nombre del roster no puede estar vacío" }
              }
            }
          },
          "404": {
            "description": "Roster no encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "Roster con ID 999 no encontrado" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Rosters"],
        "summary": "Eliminar un roster",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "204": { "description": "Roster eliminado (los jugadores permanecen)" },
          "404": {
            "description": "Roster no encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "Roster con ID 999 no encontrado" }
              }
            }
          }
        }
      }
    },
    "/rosters/{id}/jugadores": {
      "get": {
        "tags": ["Asignaciones"],
        "summary": "Listar jugadores de un roster",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Lista de jugadores asignados" },
          "404": {
            "description": "Roster no encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "Roster con ID 999 no encontrado" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Asignaciones"],
        "summary": "Asignar jugador a un roster",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AsignacionInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Jugador asignado correctamente" },
          "400": {
            "description": "Rol de roster inválido o id_jugador faltante",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "Rol en roster inválido. Debe ser uno de: Titular, Suplente" }
              }
            }
          },
          "404": {
            "description": "Roster o Jugador no encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "Roster con ID 999 no encontrado" }
              }
            }
          },
          "409": {
            "description": "Conflicto: Máximo 5 titulares, dos titulares con mismo rol o jugador ya asignado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "Conflicto de rol: ya existe un titular con el rol \"Mid\" (Faker)" }
              }
            }
          }
        }
      }
    },
    "/rosters/{id}/jugadores/{id_jugador}": {
      "put": {
        "tags": ["Asignaciones"],
        "summary": "Cambiar rol de un jugador dentro del roster",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "id_jugador", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CambiarRolInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Rol actualizado" },
          "400": {
            "description": "Rol inválido",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "Roster o asignación no encontrada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "El jugador con ID 999 no pertenece a este roster" }
              }
            }
          },
          "409": {
            "description": "Conflicto con reglas de titulares (RN-02 o RN-03)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "El roster ya cuenta con el máximo de 5 titulares" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Asignaciones"],
        "summary": "Quitar jugador del roster",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "id_jugador", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "204": { "description": "Jugador removido del roster exitosamente" },
          "404": {
            "description": "Roster o jugador no encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "mensaje": "El jugador con ID 999 no pertenece al roster" }
              }
            }
          }
        }
      }
    },
    "/roles": {
      "get": {
        "tags": ["Auxiliares"],
        "summary": "Listar roles válidos",
        "responses": {
          "200": {
            "description": "Lista de roles válidos para jugadores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string" },
                  "example": ["Top", "Jungle", "Mid", "ADC", "Support"]
                }
              }
            }
          }
        }
      }
    },
    "/estados": {
      "get": {
        "tags": ["Auxiliares"],
        "summary": "Listar estados válidos",
        "responses": {
          "200": {
            "description": "Lista de estados válidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string" },
                  "example": ["activo", "inactivo"]
                }
              }
            }
          }
        }
      }
    },
    "/tipos-roster": {
      "get": {
        "tags": ["Auxiliares"],
        "summary": "Listar tipos de roster válidos",
        "responses": {
          "200": {
            "description": "Lista de tipos de roster",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string" },
                  "example": ["Principal", "Academy"]
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Auxiliares"],
        "summary": "Verificar salud de la API y de la base de datos",
        "responses": {
          "200": { "description": "API y Base de datos funcionando correctamente" },
          "500": {
            "description": "Error en la conexión a la base de datos",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "mensaje": {
            "type": "string",
            "example": "Mensaje descriptivo del error"
          }
        }
      },
      "Jugador": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "nickname": { "type": "string", "example": "Faker" },
          "nombre_real": { "type": "string", "example": "Lee Sang-hyeok" },
          "pais": { "type": "string", "example": "Corea del Sur" },
          "rol": { "type": "string", "enum": ["Top", "Jungle", "Mid", "ADC", "Support"], "example": "Mid" },
          "estado": { "type": "string", "enum": ["activo", "inactivo"], "example": "activo" }
        }
      },
      "JugadorInput": {
        "type": "object",
        "required": ["nickname", "rol"],
        "properties": {
          "nickname": { "type": "string", "example": "Faker" },
          "nombre_real": { "type": "string", "example": "Lee Sang-hyeok" },
          "pais": { "type": "string", "example": "Corea del Sur" },
          "rol": { "type": "string", "enum": ["Top", "Jungle", "Mid", "ADC", "Support"], "example": "Mid" },
          "estado": { "type": "string", "enum": ["activo", "inactivo"], "example": "activo" }
        }
      },
      "RosterItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "nombre": { "type": "string", "example": "TL Principal" },
          "juego": { "type": "string", "example": "League of Legends" },
          "tipo": { "type": "string", "enum": ["Principal", "Academy"], "example": "Principal" },
          "temporada": { "type": "string", "example": "2025" },
          "cantidad_jugadores": { "type": "integer", "example": 2 }
        }
      },
      "RosterInput": {
        "type": "object",
        "required": ["nombre", "temporada"],
        "properties": {
          "nombre": { "type": "string", "example": "TL Principal" },
          "juego": { "type": "string", "example": "League of Legends" },
          "tipo": { "type": "string", "enum": ["Principal", "Academy"], "example": "Principal" },
          "temporada": { "type": "string", "example": "2025" }
        }
      },
      "RosterDetalle": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "nombre": { "type": "string", "example": "TL Principal" },
          "juego": { "type": "string", "example": "League of Legends" },
          "tipo": { "type": "string", "example": "Principal" },
          "temporada": { "type": "string", "example": "2025" },
          "jugadores": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer", "example": 1 },
                "nickname": { "type": "string", "example": "Faker" },
                "rol": { "type": "string", "example": "Mid" },
                "rol_en_roster": { "type": "string", "enum": ["Titular", "Suplente"], "example": "Titular" }
              }
            }
          }
        }
      },
      "AsignacionInput": {
        "type": "object",
        "required": ["id_jugador", "rol_en_roster"],
        "properties": {
          "id_jugador": { "type": "integer", "example": 1 },
          "rol_en_roster": { "type": "string", "enum": ["Titular", "Suplente"], "example": "Titular" }
        }
      },
      "CambiarRolInput": {
        "type": "object",
        "required": ["rol_en_roster"],
        "properties": {
          "rol_en_roster": { "type": "string", "enum": ["Titular", "Suplente"], "example": "Suplente" }
        }
      }
    }
  }
}
